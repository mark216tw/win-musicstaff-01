<UserControl
    x:Class="Com.Example.MusicStaffViewer.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="620" Margin="24" Spacing="20">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8D6;" FontSize="40" Foreground="{ThemeResource AppAccentBrush}" />
                    <TextBlock x:Uid="AboutTitle" Style="{StaticResource TitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Uid="AboutDescription" MaxWidth="540" TextAlignment="Center"
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <Border Background="{ThemeResource AppSurfaceBrush}" CornerRadius="8" Padding="20">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="AboutVersionTitle" Grid.ColumnSpan="2"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Grid.Row="1" />
                        <TextBlock x:Name="FileVersionText" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource AppSurfaceBrush}" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="AboutLicensesTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Uid="AboutLicenses" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource AppSurfaceBrush}" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="AboutPrivacyTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Uid="AboutPrivacy" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
